  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryDocument
  memoryId: Romina
  sceneToLoad: 9
  testimonyTitle: 'Testimonio Romina  - Cobertizo '
  testimony: "A la noche empez\xF3 a refrescar y fui al cobertizo a buscar madera
    para el fuego. Estaba todo ordenado, cada cosa en su lugar, como siempre. Cargu\xE9
    unos troncos y volv\xED a la casa. En el camino no vi nada raro afuera: ni gente
    ni luces. Estaba todo tranquilo."
  minReadSeconds: 2
