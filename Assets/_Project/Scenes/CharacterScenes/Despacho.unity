  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93af212d8f1944a9ba2a9ff7f2068dc3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryDocument
  memoryId: Mateo
  sceneToLoad: 7
  testimonyTitle: "Testimonio Mati - Living de la caba\xF1a "
  testimony: "Estuve en el living casi toda la noche. Fum\xE9 bastante, m\xE1s de
    lo que suelo. Jugu\xE9 al ajedrez con Romina, una partida larga; gan\xF3 ella,
    como siempre. \xC9ramos solo cuatro en la casa. Despu\xE9s ella se fue y me qued\xE9
    leyendo un rato en el sill\xF3n. Cuando me empez\xF3 a ganar el sue\xF1o, fui
    al ba\xF1o, me cepill\xE9 los dientes y me acost\xE9. No escuch\xE9 nada raro
    en toda la noche."
  minReadSeconds: 2
